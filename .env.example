# Copy this to .env.local (git-ignored) for local dev, and set the same
# values in Vercel's Project Settings -> Environment Variables for prod.
# See scripts/README.md for how to get the URL and key from the Google Sheet
# Apps Script deployment.

VITE_SHEET_WEBHOOK_URL=
VITE_SHEET_WEBHOOK_KEY=

# Firebase project config, only used for live head-to-head matches (see
# README.md's "Live head-to-head" section for how to create the project
# and where these values come from). Safe to leave blank — the rest of
# the app works fine without it, and the Head-to-head button just won't
# appear.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
